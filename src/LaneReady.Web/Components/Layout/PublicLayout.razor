@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="ml-3">
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">LaneReady</MudLink>
        </MudText>
        <MudSpacer />
        <MudButton Href="/check" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.CheckCircle">
            Check Eligibility
        </MudButton>
        <MudButton Href="/Identity/Account/Login" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">
            Sign In
        </MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
            @Body
        </MudContainer>
    </MudMainContent>

    <MudAppBar Bottom="true" Elevation="0" Color="Color.Transparent" Dense="true" Fixed="false">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                © @DateTime.Now.Year LaneReady Ltd · Windsor Framework Compliance
            </MudText>
        </MudContainer>
    </MudAppBar>
</MudLayout>
