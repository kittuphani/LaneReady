@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject LaneReady.Application.Common.Interfaces.ICurrentUserService CurrentUser

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1" Color="Color.Primary">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               Edge="Edge.Start" OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-2">LaneReady</MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                               Color="Color.Inherit" />
                <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="ml-2">
                    @context.User.Identity?.Name?[..1]
                </MudAvatar>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
                <NavMenu />
            </MudDrawer>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri);
        if (CurrentUser.IsAuthenticated && !CurrentUser.HasOrganisation
            && !uri.StartsWith("onboarding", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/onboarding", replace: true);
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
