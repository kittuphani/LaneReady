@page "/"
@layout PublicLayout
@attribute [AllowAnonymous]

<PageTitle>LaneReady — Windsor Framework Compliance</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" md="8" Class="text-center mt-12">
        <MudText Typo="Typo.h2" GutterBottom="true">
            Move goods into Northern Ireland on the green lane
        </MudText>
        <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-8">
            LaneReady automates Windsor Framework compliance for GB businesses —
            no customs specialist required.
        </MudText>
        <MudStack Row="true" Justify="Justify.Center" Spacing="3">
            <MudButton Href="/check" Variant="Variant.Filled" Color="Color.Primary"
                       Size="Size.Large" StartIcon="@Icons.Material.Filled.CheckCircle">
                Check Eligibility Free
            </MudButton>
            <MudButton Href="/Identity/Account/Login" Variant="Variant.Outlined" Color="Color.Primary"
                       Size="Size.Large" StartIcon="@Icons.Material.Filled.Login">
                Sign In
            </MudButton>
        </MudStack>
    </MudItem>

    <MudItem xs="12" Class="mt-16">
        <MudGrid>
            @foreach (var feature in _features)
            {
                <MudItem xs="12" md="4">
                    <MudCard Elevation="2" Class="h-100">
                        <MudCardContent>
                            <MudIcon Icon="@feature.Icon" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                            <MudText Typo="Typo.h6" GutterBottom="true">@feature.Title</MudText>
                            <MudText Color="Color.Secondary">@feature.Description</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudItem>
</MudGrid>

@code {
    private readonly (string Icon, string Title, string Description)[] _features =
    [
        (Icons.Material.Filled.QuestionAnswer,
         "Eligibility Check",
         "Answer a few questions to find out if your goods qualify for the green lane in under 2 minutes."),
        (Icons.Material.Filled.Inventory2,
         "Product Library",
         "AI-assisted commodity code classification keeps your product data clean and customs-ready."),
        (Icons.Material.Filled.LocalShipping,
         "Shipment Export",
         "Generate carrier-compliant export data and store all supporting evidence in one secure vault."),
    ];
}
