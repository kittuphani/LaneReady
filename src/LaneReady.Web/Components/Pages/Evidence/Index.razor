@page "/app/evidence"
@attribute [Authorize]
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@using LaneReady.Application.Common.Interfaces
@using LaneReady.Domain.Entities
@using LaneReady.Domain.Enums
@using Microsoft.EntityFrameworkCore
@inject IApplicationDbContext Db
@inject ICurrentUserService CurrentUser
@inject ISnackbar Snackbar

<PageTitle>Evidence — LaneReady</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">Evidence Vault</MudText>
<MudText Color="Color.Secondary" Class="mb-4">
    All documents are stored with SHA-256 integrity verification and 5-year retention.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="_documents" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>File</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Shipment</MudTh>
            <MudTh>Uploaded</MudTh>
            <MudTh>Retain Until</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="File">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@context.FileName</MudText>
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Type">
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.DocumentType</MudChip>
            </MudTd>
            <MudTd DataLabel="Shipment">@(context.ShipmentId?.ToString()[..8] ?? "—")</MudTd>
            <MudTd DataLabel="Uploaded">@context.CreatedAt.ToString("dd MMM yyyy")</MudTd>
            <MudTd DataLabel="Retain">@context.RetainUntil.ToString("dd MMM yyyy")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                               Href="@($"/api/evidence/{context.Id}/download")" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loading = true;
    private List<EvidenceDocument> _documents = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _documents = await Db.EvidenceDocuments
                .AsNoTracking()
                .OrderByDescending(e => e.CreatedAt)
                .ToListAsync();
        }
        finally { _loading = false; }
    }
}
